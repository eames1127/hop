{
	"name": "hop",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:css": "prettier --write \"src/**/*.css\"",
		"format:check": "prettier --check \"src/**/*.css\"",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "node scripts/e2e.js"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.5",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tauri-apps/cli": "^2.12.6",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vue/test-utils": "^2.6.0",
		"eslint": "^10.15.0",
		"eslint-plugin-vue": "^10.12.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vue-eslint-parser": "^10.4.2",
		"vue-tsc": "^3.3.14"
	}
}
