{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Hop",
	"version": "0.1.0",
	"identifier": "dev.eames.hop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Hop",
				"width": 1100,
				"height": 720,
				"minWidth": 640,
				"minHeight": 420,
				"visible": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "deb", "appimage"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"shortDescription": "SSH hosts as cards, one click to connect",
		"linux": {
			"deb": {
				"depends": ["openssh-client"]
			}
		}
	}
}
